{
    "compilerOptions": {
        "target": "es2020",
        "baseUrl": "./src",
        "outDir": "./dist",
        "lib": [
            "es2020",
            "dom"
        ],
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "preserveConstEnums": true,
        "sourceMap": true,
        "strict": true,
        "strictNullChecks": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,
        "alwaysStrict": true
    },
    "include": [
        "src/index.ts"
    ],
    "exclude": [
        "node_modules"
    ],
    "compileOnSave": false
}